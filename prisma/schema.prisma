// GLOPROFAS database schema (SQLite via Prisma)
// Mirrors the original repository's relational model (Drizzle/PostgreSQL),
// adapted to the sandbox SQLite deployment target.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("administrator")
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  sessions     AdminSession[]
}

model AdminSession {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model ScamReport {
  id             String   @id @default(cuid())
  reference      String   @unique
  categorySlug   String?
  description    String
  incidentDate   String?
  channel        String?
  country        String?
  city           String?
  suspiciousUrl  String?
  phoneInvolved String?
  emailInvolved String?
  moneyLost      Boolean  @default(false)
  amount         String?
  ongoing        Boolean  @default(false)
  reporterName   String?
  reporterEmail  String
  evidenceCount  Int      @default(0)
  language       String   @default("en")
  consentAt      DateTime @default(now())
  policyVersion  String   @default("2026-11")
  status         String   @default("new")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  notes ReportNote[]

  @@index([status])
  @@index([createdAt])
}

model ReportNote {
  id        String   @id @default(cuid())
  reportId  String
  report    ScamReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  author    String   @default("system")
  note      String
  createdAt DateTime @default(now())

  @@index([reportId])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  category  String   @default("general")
  message   String
  language  String   @default("en")
  status    String   @default("new")
  createdAt DateTime @default(now())
}

model NewsletterSubscriber {
  id       String   @id @default(cuid())
  name     String?
  email    String   @unique
  country  String?
  language String   @default("en")
  status   String   @default("pending")
  consentAt DateTime @default(now())
  createdAt DateTime @default(now())
}

model VolunteerApplication {
  id           String   @id @default(cuid())
  name         String
  email        String
  background   String?
  skills       String?
  languages    String?
  interests    String?
  motivation   String?
  language     String   @default("en")
  status       String   @default("new")
  createdAt    DateTime @default(now())
}

model PartnershipApplication {
  id               String   @id @default(cuid())
  organisation     String
  organisationType String?
  contactPerson   String
  email            String
  phone            String?
  country          String?
  proposal         String
  language         String   @default("en")
  status           String   @default("new")
  createdAt        DateTime @default(now())
}

model ServiceEnquiry {
  id            String   @id @default(cuid())
  name          String
  organisation  String?
  email         String
  phone         String?
  country       String?
  serviceSlug   String
  requirements  String
  contactMethod String   @default("email")
  language      String   @default("en")
  status        String   @default("new")
  createdAt     DateTime @default(now())
}

model ActivityLog {
  id        String   @id @default(cuid())
  actor     String
  action    String
  entity    String?
  entityId  String?
  createdAt DateTime @default(now())
}

model RateLimit {
  id          String   @id @default(cuid())
  key         String
  windowStart DateTime
  count       Int      @default(1)

  @@unique([key, windowStart])
}

// ---------------- Resource Centre CMS models ----------------

model Article {
  id            String   @id @default(cuid())
  slug          String   @unique
  categorySlug  String
  content       String   // full Article JSON (bilingual)
  published     Boolean  @default(true)
  featured      Boolean  @default(false)
  popular       Boolean  @default(false)
  displayOrder  Int      @default(0)
  publishedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  @@index([categorySlug])
  @@index([published])
}

model VideoResource {
  id           String   @id @default(cuid())
  youtubeId    String   @unique
  content      String   // full VideoResource JSON (bilingual)
  published    Boolean  @default(true)
  displayOrder Int      @default(0)
  verified     Boolean  @default(true)
  verifiedAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ChecklistItem {
  id             String   @id @default(cuid())
  slug           String   @unique
  content        String   // full Checklist JSON (bilingual)
  published      Boolean  @default(true)
  featured       Boolean  @default(false)
  downloadCount  Int      @default(0)
  fileEn         String   @default("")
  fileFr         String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model DirectoryCountry {
  id           String   @id @default(cuid())
  code         String   @unique
  content      String   // full DirectoryCountry JSON (bilingual notes)
  status       String   @default("verified") // verified | pending-verification | requires-review | outdated
  lastVerified DateTime @default(now())
  nextReview   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
}

model CheckerPattern {
  id          String   @id @default(cuid())
  indicatorId String   @unique
  category    String
  weight      Int      @default(1)
  content     String   // { label, explanation } JSON bilingual
  patterns    String   // JSON array of regex sources
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
