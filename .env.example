APP_NAME=GLOPROFAS
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,fr

# Storage. The reference stack specifies MySQL 8; this deployment target runs
# PostgreSQL 16 with the same relational model through Drizzle ORM (documented
# deviation in docs/PROJECT_BRIEF.md).
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/gloprofas

SESSION_SECRET=
APP_ENCRYPTION_KEY=
PRIVATE_STORAGE_PATH=./storage/private

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=GLOPROFAS

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

ADMIN_EMAIL=admin@gloprofas.org
ADMIN_INITIAL_PASSWORD=
WORKER_TOKEN=
