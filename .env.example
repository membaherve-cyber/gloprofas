# GLOPROFAS environment variables
# Copy to .env for local development. On Vercel, set these in
# Project → Settings → Environment Variables (see docs/VERCEL.md).

# SQLite database file (local development).
# On Vercel this is optional: if unset, the committed demo database
# (db/custom.db) is copied to /tmp automatically at runtime.
DATABASE_URL=file:./db/custom.db

# Initial password for the seeded admin account (admin@gloprofas.org).
# Only takes effect when the admin user table is empty. Change it before
# any real deployment.
ADMIN_INITIAL_PASSWORD=

# Optional: z-ai SDK settings for the Oskie assistant and other AI features.
# The site works without them (assistant falls back to published content).
ZAI_API_KEY=
